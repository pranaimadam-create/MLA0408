# ============================================================
# Q4: LSTM STOCK PRICE PREDICTION
# Using Backpropagation Through Time (BPTT)
# ============================================================

import numpy as np
import tensorflow as tf
from tensorflow.keras import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout

print("=" * 60)
print("Q4 - LSTM STOCK PRICE PREDICTION")
print("BACKPROPAGATION THROUGH TIME (BPTT)")
print("=" * 60)

# ------------------------------------------------------------
# 1. Create sample stock price data
# ------------------------------------------------------------

print("\nCreating sample stock price data...")

np.random.seed(42)

prices = np.linspace(100, 180, 300)

noise = np.random.normal(
    0,
    3,
    300
)

prices = prices + noise

prices = prices.astype("float32")

# ------------------------------------------------------------
# 2. Normalize the data
# ------------------------------------------------------------

minimum = prices.min()
maximum = prices.max()

scaled_prices = (
    (prices - minimum) /
    (maximum - minimum)
)

# ------------------------------------------------------------
# 3. Create sequences
# ------------------------------------------------------------

WINDOW = 20

X = []
y = []

for i in range(
    WINDOW,
    len(scaled_prices)
):

    X.append(
        scaled_prices[i-WINDOW:i]
    )

    y.append(
        scaled_prices[i]
    )

X = np.array(X)
y = np.array(y)

# Add feature dimension
X = X.reshape(
    X.shape[0],
    X.shape[1],
    1
)

print("\nInput Shape :", X.shape)
print("Output Shape:", y.shape)

# ------------------------------------------------------------
# 4. Split training and testing data
# ------------------------------------------------------------

split = int(
    0.8 * len(X)
)

X_train = X[:split]
X_test = X[split:]

y_train = y[:split]
y_test = y[split:]

print("\nTraining Samples:", len(X_train))
print("Testing Samples :", len(X_test))

# ------------------------------------------------------------
# 5. Create LSTM model
# ------------------------------------------------------------

model = Sequential([

    LSTM(
        64,
        return_sequences=True,
        input_shape=(WINDOW, 1)
    ),

    Dropout(0.2),

    LSTM(
        32
    ),

    Dropout(0.2),

    Dense(
        1
    )
])

# ------------------------------------------------------------
# 6. Compile model
# ------------------------------------------------------------

model.compile(
    optimizer="adam",
    loss="mse",
    metrics=["mae"]
)

print("\nLSTM model created successfully!")

model.summary()

# ------------------------------------------------------------
# 7. Train model
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("TRAINING MODEL")
print("=" * 60)

print("\nBackpropagation Through Time (BPTT)")
print("is automatically performed during training.")

history = model.fit(
    X_train,
    y_train,
    epochs=5,
    batch_size=16,
    validation_split=0.1,
    shuffle=False
)

# ------------------------------------------------------------
# 8. Evaluate model
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("MODEL EVALUATION")
print("=" * 60)

loss, mae = model.evaluate(
    X_test,
    y_test,
    verbose=0
)

print("\nTest MSE :", round(loss, 4))
print("Test MAE :", round(mae, 4))

# ------------------------------------------------------------
# 9. Predict stock prices
# ------------------------------------------------------------

print("\nGenerating predictions...")

predictions = model.predict(
    X_test,
    verbose=0
)

# Convert normalized values back
predicted_prices = (
    predictions.flatten()
    * (maximum - minimum)
    + minimum
)

actual_prices = (
    y_test
    * (maximum - minimum)
    + minimum
)

print("\nFirst 10 Predictions:")
print("-" * 40)

for i in range(
    min(10, len(predicted_prices))
):

    print(
        "Actual:",
        round(float(actual_prices[i]), 2),
        " | Predicted:",
        round(float(predicted_prices[i]), 2)
    )

# ------------------------------------------------------------
# 10. Save model
# ------------------------------------------------------------

model.save(
    "lstm_stock_prediction.keras"
)

print("\nModel saved successfully!")

print("\n" + "=" * 60)
print("Q4 PROGRAM COMPLETED SUCCESSFULLY")
print("=" * 60)
